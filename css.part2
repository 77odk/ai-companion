  font-size: 18px;
  font-weight: 700;
  color: var(--color-text);
}
.work-memory {
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}
.showcase-card {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.showcase-head {
  display: flex;
  align-items: center;
  gap: 10px;
}
.showcase-icon {
  width: 22px;
  height: 22px;
  color: var(--color-primary-deep);
  flex: none;
}
.showcase-icon svg {
  width: 22px;
  height: 22px;
}
.showcase-badge {
  margin-left: auto;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  color: var(--color-primary, #ff8a5c);
  background: rgba(255, 138, 92, 0.12);
  white-space: nowrap;
}
/* 工作台 v2 · 点菜台（展示模式：主卖点 + 对话式入口 + 已会能力小块 + 底部钩子） */
.work-hero {
  margin: 4px 0 0;
  font-size: 22px;
  font-weight: 800;
  line-height: 1.5;
  text-align: center;
  color: var(--color-text);
}
/* 「我的」页里的工作台子页：避免 .page 双层内边距，工作台自身内容不再套一层 */
.work-subpage {
  gap: 8px;
}
.work-subpage .work-page {
  padding: 0 0 8px;
  overflow: visible;
}
.work-ask-card {
  background: linear-gradient(135deg, #fff1e0 0%, #ffffff 55%, #ffe7d0 100%);
  border: 1px solid #f3dcc7;
  box-shadow: var(--shadow);
}
.work-ask-desc {
  margin: 0 0 12px;
  font-size: 14px;
  line-height: 1.7;
  color: var(--color-text);
}
.work-ask-row {
  display: flex;
  gap: 8px;
}
.work-ask-row .input {
  flex: 1;
}
.work-ask-btn {
  flex: none;
  white-space: nowrap;
}
.work-ask-hint {
  margin: 8px 0 0;
  font-size: 12px;
  color: var(--color-primary-deep);
}
.work-known-title {
  margin: 0 0 6px;
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text);
}
.work-known-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px 12px;
}
.work-known-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 2px;
  font-size: 13px;
  color: var(--color-text);
  min-width: 0;
}
.work-known-icon {
  width: 16px;
  height: 16px;
  color: var(--color-primary-deep);
  flex: none;
}
.work-known-icon svg {
  width: 16px;
  height: 16px;
}
.work-known-name {
  flex: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.work-known-item .showcase-badge {
  margin-left: auto;
}
.work-foot-hook {
  margin: 2px 0 0;
  font-size: 13px;
  line-height: 1.7;
  color: var(--color-text-muted);
  text-align: center;
}
.work-lock-desc {
  margin-bottom: 12px;
}
.work-file-pick {
  margin-top: 4px;
}
.work-file-btn {
  width: 100%;
  padding: 12px;
  background: var(--color-bg);
  border: 1px dashed var(--color-border);
}
.work-files {
  margin: 8px 0 0;
  word-break: break-all;
}
.work-checks {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}
.work-check {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--color-text);
}
.work-check input {
  accent-color: var(--color-primary);
}
.work-regex {
  margin-top: 8px;
}
.work-row {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}
.work-row .field {
  flex: 1;
}
.work-actions {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}
.work-actions .btn {
  flex: 1;
}
.work-result-area {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.work-progress {
  color: var(--color-primary-deep);
}
.work-done {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: stretch;
}
/* ========== 欢迎页（品牌入口，未来升级为登录页） ========== */
.welcome-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow-y: auto;
  text-align: center;
  padding: 24px 20px;
}
.welcome-inner {
  margin: auto;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.welcome-logo {
  width: 88px;
  height: 88px;
  border-radius: 26px;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
  color: var(--color-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  box-shadow: 0 8px 24px rgba(255, 138, 92, 0.35);
}
.welcome-logo-mark {
  font-size: 44px;
  font-weight: 700;
  line-height: 1;
}
.welcome-name {
  margin: 0 0 2px;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--color-text);
}
.welcome-en {
  margin: 0 0 10px;
  font-size: 13px;
  letter-spacing: 0.3em;
  color: var(--color-text-muted);
}
.welcome-slogan {
  margin: 0 0 22px;
  font-size: 16px;
  letter-spacing: 0.08em;
  color: var(--color-text);
}
.welcome-features {
  display: flex;
  gap: 8px;
  margin-bottom: 28px;
}
.welcome-feature {
  padding: 5px 14px;
  border-radius: 999px;
  font-size: 13px;
  color: var(--color-primary);
  background: rgba(255, 138, 92, 0.1);
  border: 1px solid rgba(255, 138, 92, 0.25);
}
.welcome-start {
  width: 100%;
  max-width: 260px;
  padding: 13px 0;
  font-size: 16px;
}
.welcome-foot {
  margin: 18px 0 0;
  font-size: 12px;
  color: var(--color-text-muted);
}
.welcome-count {
  margin: 8px 0 0;
  font-size: 12px;
  color: var(--color-text-muted);
}
.version-tag {
  margin: 18px 0 0;
  font-size: 11px;
  text-align: center;
  color: var(--color-text-muted);
  opacity: 0.7;
}
/* ========== AI 空间（TA 的朋友圈/生活） ========== */
.ai-space-page {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  overflow-y: auto;
}
.ai-space-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18px 20px 18px;
  text-align: center;
  background: linear-gradient(180deg, rgba(255, 138, 92, 0.08), transparent);
}
.ai-space-topbar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}
.ai-space-back {
  font-size: 13px;
  padding: 0;
}
.ai-space-title {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1px;
}
.ai-space-topbar-spacer {
  width: 42px;
  flex: none;
}
.ai-space-avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  background: var(--color-card);
  border: 2px solid rgba(255, 138, 92, 0.4);
  box-shadow: 0 6px 18px rgba(255, 138, 92, 0.2);
}
.ai-space-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* 空间角色头像：有会话时取角色名首字（S2，主色软底文字） */
.ai-space-avatar-letter {
  color: var(--color-primary-deep);
  font-size: 34px;
  font-weight: 700;
  line-height: 1;
}
.ai-space-avatar .avatar-default {
  width: 55%;
  height: 55%;
}
.ai-space-name {
  margin: 12px 0 4px;
  font-size: 20px;
  font-weight: 700;
  color: var(--color-text);
}
.ai-space-bio {
  margin: 0;
  font-size: 12px;
  color: var(--color-text-muted);
  line-height: 1.6;
}
.ai-space-timeline {
  flex: 1;
  padding: 8px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ai-space-post {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
  padding: 0;
}
.ai-space-post-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.ai-space-post-kind {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 999px;
  color: var(--color-primary);
  background: rgba(255, 138, 92, 0.1);
}
.ai-space-post-time {
  font-size: 11px;
  color: var(--color-text-muted);
}
.ai-space-post-text {
  margin: 0;
  font-size: 14px;
  line-height: 1.7;
  color: var(--color-text);
}
/* 动态配图区：柔和渐变底色 + 居中线条插画 */
.ai-space-art {
  height: 150px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.ai-space-art-svg {
  width: 130px;
  height: 88px;
}
.ai-space-post-body {
  padding: 12px 14px;
}
/* 每种 kind 一档柔和渐变（暖橘/奶白/浅灰系，跟记忆页主题色块同族） */
.art-tone-0 {
  background: linear-gradient(135deg, rgba(255, 138, 92, 0.2), rgba(255, 240, 230, 0.9));
  color: #b26a4e;
}
.art-tone-1 {
  background: linear-gradient(135deg, rgba(132, 169, 74, 0.18), rgba(243, 247, 232, 0.9));
  color: #6b7f3f;
}
.art-tone-2 {
  background: linear-gradient(135deg, rgba(90, 148, 196, 0.18), rgba(232, 241, 248, 0.9));
  color: #4d7b9e;
}
.art-tone-3 {
  background: linear-gradient(135deg, rgba(164, 106, 192, 0.18), rgba(245, 234, 248, 0.9));
  color: #8a5aa8;
}
.art-tone-4 {
  background: linear-gradient(135deg, rgba(224, 168, 84, 0.2), rgba(252, 244, 228, 0.9));
  color: #b07f3a;
}
.art-tone-5 {
  background: linear-gradient(135deg, rgba(214, 106, 130, 0.16), rgba(252, 236, 240, 0.9));
  color: #a24e5e;
}
/* 列表顶部的更新提示行 + 刷新按钮 */
.ai-space-update-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2px 2px 0;
}
.ai-space-update {
  font-size: 12px;
  color: var(--color-text-muted);
}
.ai-space-refresh {
  width: 32px;
  height: 32px;
  flex: none;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
}
.ai-space-refresh:hover {
  color: var(--color-primary-deep);
  border-color: rgba(255, 138, 92, 0.4);
  background: rgba(255, 138, 92, 0.06);
}
.ai-space-refresh svg {
  width: 16px;
  height: 16px;
}
.ai-space-hint {
  margin: 0;
  padding: 0 2px;
  font-size: 12px;
  color: var(--color-primary-deep);
  opacity: 0.85;
}
/* 没设人设时的引导卡片：跳「我的」写人设 */
.ai-space-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 16px 14px;
  border: 1px dashed rgba(255, 138, 92, 0.4);
  border-radius: var(--radius-md);
  background: rgba(255, 138, 92, 0.06);
  text-align: center;
}
.ai-space-guide-text {
  margin: 0;
  font-size: 13px;
  color: var(--color-text);
  line-height: 1.6;
}
.ai-space-guide-btn {
  font-size: 13px;
}
.ai-space-foot {
  padding: 4px 20px 20px;
  font-size: 12px;
  text-align: center;
  color: var(--color-text-muted);
}
.ai-space-entry {
  width: 100%;
  margin-bottom: 12px;
}
/* 微信式资料页 · 功能入口列表：圆角卡片一组，每条=线条图标+标题+副标题+右箭头 */
.ai-space-entry-list {
  display: flex;
  flex-direction: column;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.ai-space-entry-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 14px;
  border: none;
  background: transparent;
  font-family: inherit;
  cursor: pointer;
  color: var(--color-text);
  text-align: left;
  transition: background 0.15s;
}
.ai-space-entry-row + .ai-space-entry-row {
  border-top: 1px solid var(--color-border);
}
.ai-space-entry-row:hover {
  background: rgba(255, 138, 92, 0.05);
}
.ai-space-entry-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(255, 138, 92, 0.1);
  color: var(--color-primary-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.ai-space-entry-icon svg {
  width: 18px;
  height: 18px;
}
.ai-space-entry-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.ai-space-entry-title {
  font-size: 15px;
  font-weight: 500;
  color: var(--color-text);
}
.ai-space-entry-sub {
  font-size: 12px;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-space-entry-chevron {
  width: 16px;
  height: 16px;
  color: var(--color-text-muted);
  flex: none;
  transition: transform 0.2s ease;
}
.ai-space-entry-chevron-open {
  transform: rotate(90deg);
}
/* 底部独立卡片：刷新对话（M7-3 生效，展开二次确认） */
.ai-space-refresh-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-card);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.ai-space-refresh-card .ai-space-entry-refresh {
  border: none;
  border-radius: 0;
  box-shadow: none;
}
.ai-space-refresh-confirm {
  padding: 0 14px 14px;
  border-top: 1px solid var(--color-border);
}
.ai-space-refresh-confirm-text {
  margin: 12px 0 10px;
  font-size: 13px;
  color: var(--color-text);
  line-height: 1.5;
}
.ai-space-refresh-confirm-actions {
  display: flex;
  gap: 8px;
}
.ai-space-refresh-confirm-actions .btn {
  font-size: 13px;
}
/* ========== TA 的详情页：相处数据 / 聊天记录 / TA 记得的 ========== */
/* 相处数据卡：一行三个数字 */
.ai-space-stats {
  display: flex;
  align-items: stretch;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  padding: 14px 6px;
}
.ai-space-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.ai-space-stat + .ai-space-stat {
  border-left: 1px solid var(--color-border);
}
.ai-space-stat-icon {
  width: 20px;
  height: 20px;
  color: var(--color-primary-deep);
  margin-bottom: 2px;
}
.ai-space-stat-icon svg {
  width: 20px;
  height: 20px;
}
.ai-space-stat-num {
  font-size: 17px;
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-text);
}
.ai-space-stat-label {
  font-size: 11px;
  color: var(--color-text-muted);
}
/* 区块标题：线条小图标 + 标题 + 右侧计数 */
.ai-space-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.ai-space-section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 2px 2px 0;
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text);
}
.ai-space-section-title-icon {
  width: 16px;
  height: 16px;
  color: var(--color-primary-deep);
  flex: none;
}
.ai-space-section-title-icon svg {
  width: 16px;
  height: 16px;
}
.ai-space-section-count {
  margin-left: auto;
  font-size: 12px;
  font-weight: 500;
  color: var(--color-text-muted);
}
/* 空状态 */
.ai-space-empty {
  padding: 18px 14px;
  text-align: center;
  background: var(--color-card);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-md);
  font-size: 13px;
  line-height: 1.6;
  color: var(--color-text-muted);
}
/* 聊天记录：按天分组列表 */
.ai-space-day-list {
  display: flex;
  flex-direction: column;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.ai-space-day-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border: none;
  background: transparent;
  font-family: inherit;
  text-align: left;
  cursor: pointer;
  color: var(--color-text);
  transition: background 0.15s;
}
.ai-space-day-item + .ai-space-day-item {
  border-top: 1px solid var(--color-border);
}
.ai-space-day-item:hover {
  background: rgba(255, 138, 92, 0.05);
}
.ai-space-day-name {
  flex: none;
  font-size: 14px;
  font-weight: 600;
}
.ai-space-day-preview {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
  color: var(--color-text-muted);
}
.ai-space-day-count {
  flex: none;
  font-size: 12px;
  color: var(--color-text-muted);
}
.ai-space-day-chevron {
  width: 14px;
  height: 14px;
  color: var(--color-text-muted);
  flex: none;
}
/* 聊天记录子页（M7-2）：搜索框 */
.ai-space-search {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 40px;
  padding: 0 12px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  box-shadow: var(--shadow);
}
.ai-space-search-icon {
  width: 16px;
  height: 16px;
  color: var(--color-text-muted);
  flex: none;
}
.ai-space-search-icon svg {
  width: 16px;
  height: 16px;
}
.ai-space-search-input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  background: transparent;
  font-family: inherit;
  font-size: 14px;
  color: var(--color-text);
}
.ai-space-search-input::placeholder {
  color: var(--color-text-muted);
}
.ai-space-search-clear {
  width: 22px;
  height: 22px;
  flex: none;
  border: none;
  border-radius: 50%;
  background: rgba(154, 125, 116, 0.15);
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.ai-space-search-clear:hover {
  color: var(--color-primary-deep);
  background: rgba(255, 138, 92, 0.15);
}
.ai-space-search-clear svg {
  width: 12px;
  height: 12px;
}
/* 搜索结果：日期 + 摘要 + 前后上下文 */
.ai-space-search-results {
  display: flex;
  flex-direction: column;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.ai-space-search-item {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 14px;
  border: none;
  background: transparent;
  font-family: inherit;
  text-align: left;
  cursor: pointer;
  color: var(--color-text);
  transition: background 0.15s;
}
.ai-space-search-item + .ai-space-search-item {
  border-top: 1px solid var(--color-border);
}
.ai-space-search-item:hover {
  background: rgba(255, 138, 92, 0.05);
}
.ai-space-search-item-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
  min-width: 0;
}
.ai-space-search-day {
  flex: none;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-primary-deep);
}
.ai-space-search-summary {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  color: var(--color-text);
}
.ai-space-search-ctx {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-left: 4px;
}
.ai-space-search-ctx-line {
  display: flex;
  align-items: baseline;
  gap: 6px;
  font-size: 12px;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-space-search-ctx-tag {
  flex: none;
  font-size: 11px;
  color: var(--color-primary-deep);
  opacity: 0.75;
}
/* 日历：简洁网格，暖橘高亮今天，圆点标记有记录的天 */
.ai-space-cal {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  padding: 12px 12px 10px;
}
.ai-space-cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.ai-space-cal-nav {
  width: 30px;
  height: 30px;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: color 0.15s, background 0.15s;
}
.ai-space-cal-nav svg {
  width: 18px;
  height: 18px;
}
.ai-space-cal-nav:disabled {
  opacity: 0.3;
  cursor: default;
}
.ai-space-cal-nav:not(:disabled):hover {
  color: var(--color-primary-deep);
  background: rgba(255, 138, 92, 0.1);
}
.ai-space-cal-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text);
}
.ai-space-cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2px;
}
.ai-space-cal-dow {
  padding: 4px 0 6px;
  text-align: center;
  font-size: 12px;
  color: var(--color-text-muted);
}
.ai-space-cal-cell {
  position: relative;
  height: 36px;
  border: none;
  border-radius: 10px;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  color: var(--color-text);
  transition: background 0.15s;
}
.ai-space-cal-cell:disabled {
  cursor: default;
}
.ai-space-cal-cell:not(:disabled):hover {
  background: rgba(255, 138, 92, 0.1);
}
.ai-space-cal-cell:disabled .ai-space-cal-day {
  color: var(--color-text-muted);
  opacity: 0.55;
}
.ai-space-cal-blank {
  cursor: default;
}
.ai-space-cal-day {
  font-size: 13px;
  line-height: 1;
}
/* 今天：暖橘色块高亮（不管有没有记录都看得见） */
.ai-space-cal-today {
  background: rgba(255, 138, 92, 0.12);
}
.ai-space-cal-today:not(:disabled):hover {
  background: rgba(255, 138, 92, 0.22);
}
.ai-space-cal-today .ai-space-cal-day {
  color: var(--color-primary-deep);
  font-weight: 700;
}
.ai-space-cal-dot {
  position: absolute;
  bottom: 4px;
  left: 50%;
  transform: translateX(-50%);
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--color-primary);
}
/* 按天折叠目录 */
.ai-space-day-dir {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ai-space-dir-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  padding: 0 4px;
}
.ai-space-dir-tool {
  border: none;
  background: transparent;
  font-family: inherit;
  font-size: 12px;
  color: var(--color-text-muted);
  padding: 4px 6px;
  border-radius: 6px;
  transition: color 0.15s, background 0.15s;
}
.ai-space-dir-tool:hover {
  color: var(--color-primary-deep);
  background: rgba(255, 138, 92, 0.08);
}
.ai-space-dir-tool-sep {
  width: 1px;
  height: 12px;
  background: var(--color-border);
}
.ai-space-dir-day {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.ai-space-dir-head {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border: none;
  background: transparent;
  font-family: inherit;
  text-align: left;
  cursor: pointer;
  color: var(--color-text);
  transition: background 0.15s;
}
.ai-space-dir-head:hover {
  background: rgba(255, 138, 92, 0.05);
}
.ai-space-dir-name {
  flex: none;
  font-size: 14px;
  font-weight: 600;
}
.ai-space-dir-preview {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
  color: var(--color-text-muted);
}
.ai-space-dir-count {
  flex: none;
  font-size: 12px;
  color: var(--color-text-muted);
}
.ai-space-dir-chevron {
  width: 14px;
  height: 14px;
  color: var(--color-text-muted);
  flex: none;
  transition: transform 0.2s ease;
}
.ai-space-dir-day-open .ai-space-dir-chevron {
  transform: rotate(90deg);
}
.ai-space-dir-body {
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
}
.ai-space-dir-msg {
  width: 100%;
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 9px 14px;
  border: none;
  border-top: 1px solid var(--color-border);
  background: transparent;
  font-family: inherit;
  text-align: left;
  cursor: pointer;
  color: var(--color-text);
  transition: background 0.15s;
}
.ai-space-dir-msg:first-child {
  border-top: none;
}
.ai-space-dir-msg:hover {
  background: rgba(255, 138, 92, 0.05);
}
.ai-space-dir-msg-role {
  flex: none;
  font-size: 11px;
  color: var(--color-primary-deep);
  opacity: 0.8;
  min-width: 34px;
}
.ai-space-dir-msg-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
  color: var(--color-text);
}
.ai-space-dir-open {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 9px 14px;
  border: none;
  border-top: 1px solid var(--color-border);
  background: transparent;
  font-family: inherit;
  font-size: 12px;
  color: var(--color-primary-deep);
  cursor: pointer;
  transition: background 0.15s;
}
.ai-space-dir-open:hover {
  background: rgba(255, 138, 92, 0.06);
}
.ai-space-dir-open-chevron {
  width: 12px;
  height: 12px;
}
/* TA 记得的：记忆时间线 */
.ai-space-memory-list {
  display: flex;
  flex-direction: column;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.ai-space-memory-item {
  padding: 12px 14px;
}
.ai-space-memory-item + .ai-space-memory-item {
  border-top: 1px solid var(--color-border);
}
.ai-space-memory-text {
  margin: 0 0 6px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text);
  word-break: break-word;
}
.ai-space-memory-date {
  font-size: 12px;
  color: var(--color-primary-deep);
  opacity: 0.85;
}
/* 聊天记录二级视图：全屏替换详情页内容 */
.ai-space-page-log {
  padding: 0;
  gap: 0;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}
.ai-space-log {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.ai-space-log-bar {
  margin-bottom: 0;
  padding: 12px 14px;
  flex-shrink: 0;
  background: var(--color-card);
  border-bottom: 1px solid var(--color-border);
}
.ai-space-log-title {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--color-text);
}
.ai-space-log-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.ai-space-log-role {
  font-size: 11px;
  color: var(--color-text-muted);
  margin-bottom: 2px;
}
.ai-space-log-foot {
  flex-shrink: 0;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--color-border);
  background: var(--color-card);
}
.ai-space-log-foot .btn {
  width: 100%;
}
/* TA 空间的子页面（聊天记录 / TA 记得的 / TA 的生活）：顶部 ‹ 返回 + 标题，页面内滚动 */
.ai-space-page-sub {
  padding: 0;
}
.ai-space-sub-bar {
  position: sticky;
  top: 0;
  z-index: 5;
  margin-bottom: 0;
  padding: 12px 14px;
  flex-shrink: 0;
  background: var(--color-card);
  border-bottom: 1px solid var(--color-border);
}
.ai-space-sub-title {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--color-text);
}
/* ========== 我的页 · 个人中心 ========== */
.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 28px 20px 22px;
  border-radius: var(--radius-md);
  background: linear-gradient(160deg, rgba(255, 138, 92, 0.1), rgba(255, 211, 182, 0.28));
  border: 1px solid rgba(255, 138, 92, 0.18);
  text-align: center;
}
.profile-avatar-wrap {
  position: relative;
  margin-bottom: 2px;
}
.profile-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  border: 2px solid rgba(255, 138, 92, 0.35);
  background: var(--color-card);
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
  box-shadow: 0 6px 18px rgba(255, 138, 92, 0.22);
  transition: transform 0.15s, border-color 0.15s;
}
.profile-avatar:hover {
  border-color: var(--color-primary);
}
.profile-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.profile-avatar .avatar-default {
  width: 58%;
  height: 58%;
}
.profile-avatar-badge {
  position: absolute;
  right: -2px;
  bottom: -2px;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--color-primary);
  color: var(--color-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--color-card);
}
.profile-avatar-badge svg {
  width: 15px;
  height: 15px;
}
.profile-name {
  border: none;
  background: transparent;
  width: 100%;
  font-size: 20px;
  font-weight: 700;
  color: var(--color-text);
  text-align: center;
  outline: none;
  font-family: inherit;
}
.profile-bio {
  border: none;
  background: transparent;
  width: 100%;
  font-size: 14px;
  color: var(--color-text-muted);
  text-align: center;
  outline: none;
  font-family: inherit;
}
.profile-name::placeholder,
.profile-bio::placeholder {
  color: var(--color-text-muted);
  opacity: 0.75;
}
.profile-name:focus,
.profile-bio:focus {
  border-bottom: 1px dashed rgba(255, 138, 92, 0.45);
}
.profile-avatar-pick {
  width: 100%;
  padding-top: 14px;
  border-top: 1px dashed rgba(255, 138, 92, 0.3);
}
.profile-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.profile-group-title {
  margin: 4px 4px 0;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-text-muted);
  letter-spacing: 0.04em;
}
.profile-group-card {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.entry-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 14px;
  border: none;
  background: transparent;
  font-family: inherit;
  cursor: pointer;
  color: var(--color-text);
  text-align: left;
}
.entry-row + .entry-row {
  border-top: 1px solid var(--color-border);
}
.entry-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(255, 138, 92, 0.1);
  color: var(--color-primary-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.entry-icon svg {
  width: 18px;
  height: 18px;
}
.entry-label {
  flex: 1;
  font-size: 15px;
  font-weight: 500;
}
.entry-chevron {
  width: 16px;
  height: 16px;
  color: var(--color-text-muted);
  flex: none;
}
.entry-status {
  flex: none;
  max-width: 44%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  color: var(--color-text-muted);
}
/* 详情页通用头部 */
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2px;
}
.detail-back {
  width: 38px;
  height: 38px;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.15s, border-color 0.15s;
}
.detail-back:hover {
  color: var(--color-primary-deep);
  border-color: rgba(255, 138, 92, 0.4);
}
.detail-back svg {
  width: 18px;
  height: 18px;
}
.detail-title {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
  color: var(--color-text);
}
.detail-spacer {
  width: 38px;
  flex: none;
}
/* 关于忆文 */
.about-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 36px 24px 28px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  text-align: center;
}
.about-logo {
  width: 72px;
  height: 72px;
  border-radius: 22px;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
  color: var(--color-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  box-shadow: 0 8px 20px rgba(255, 138, 92, 0.3);
}
.about-logo span {
  font-size: 36px;
  font-weight: 700;
  line-height: 1;
}
.about-name {
  margin: 0;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--color-text);
}
.about-en {
  margin: 0;
  font-size: 12px;
  letter-spacing: 0.3em;
  color: var(--color-text-muted);
}
.about-slogan {
  margin: 10px 0 4px;
  font-size: 15px;
  letter-spacing: 0.08em;
  color: var(--color-text);
}
.about-intro {
  margin: 0 0 18px;
  font-size: 13px;
  line-height: 1.7;
  color: var(--color-text-muted);
}
.about-version {
  border: none;
  background: none;
  color: var(--color-text-muted);
  font-size: 12px;
  padding: 8px 16px;
  border-radius: 999px;
  cursor: pointer;
  opacity: 0.8;
}
/* ========== 使用指南 ========== */
.guide-scroll {
  padding: 8px 0 24px;
}
.guide-section {
  margin-bottom: 18px;
}
.guide-title {
  margin: 0 0 10px;
  font-size: 16px;
  font-weight: 700;
  color: var(--color-text);
}
.guide-text {
  margin: 0 0 10px;
  font-size: 14px;
  line-height: 1.75;
  color: var(--color-text);
}
.guide-card {
  padding: 14px 16px;
  margin-bottom: 10px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
.guide-card-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}
.guide-card-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text);
}
.guide-chip {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 10px;
  border-radius: 999px;
  flex: none;
}
.chip-free {
  background: rgba(255, 138, 92, 0.14);
  color: var(--color-primary-deep);
}
.chip-paid {
  background: rgba(154, 125, 116, 0.14);
  color: var(--color-text-muted);
}
.guide-card-note {
  margin: 0 0 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--color-primary-deep);
}
.guide-card .guide-text {
  margin-bottom: 6px;
}
.guide-fit {
  margin: 0;
  font-size: 12px;
  color: var(--color-text-muted);
}
.guide-quote {
  padding: 10px 14px;
  background: rgba(255, 138, 92, 0.08);
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.7;
  color: var(--color-primary-deep);
  text-align: center;
}
.guide-list {
  margin: 0 0 10px;
  padding-left: 18px;
  font-size: 14px;
  line-height: 1.75;
  color: var(--color-text);
}
.guide-list li {
  margin-bottom: 4px;
}
.guide-step {
  padding: 14px 16px;
  margin-bottom: 10px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
.guide-step-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}
.guide-step-num {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
  color: var(--color-on-primary);
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.guide-step-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text);
}
.guide-ol {
  margin: 0;
  padding-left: 18px;
  font-size: 14px;
  line-height: 1.75;
  color: var(--color-text);
}
.guide-ol li {
  margin-bottom: 3px;
}
.guide-cta {
  width: 100%;
  margin-top: 6px;
}
/* ========== 选角色引导页（RolePicker） ========== */
.role-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow-y: auto;
  padding: 36px 20px 32px;
}
.role-inner {
  width: 100%;
  display: flex;
  flex-direction: column;
}
.role-title {
  margin: 0;
  font-size: 24px;
  font-weight: 800;
  color: var(--color-text);
  text-align: center;
}
.role-sub {
  margin: 8px auto 26px;
  font-size: 12px;
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.6;
}
.role-templates {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.role-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 14px 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-card);
  text-align: left;
  font-family: inherit;
  color: var(--color-text);
  transition: border-color 0.15s, background 0.15s, transform 0.1s;
}
.role-card:hover {
  border-color: rgba(255, 138, 92, 0.5);
  background: rgba(255, 138, 92, 0.04);
}
.role-card:active {
  transform: scale(0.99);
  background: var(--color-primary-soft);
}
.role-card-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text);
}
.role-card-tagline {
  font-size: 13px;
  color: var(--color-text-muted);
  line-height: 1.5;
}
.role-custom {
  margin-top: 16px;
}
.role-custom-toggle {
  width: 100%;
  padding: 14px 16px;
  border: 1px dashed rgba(255, 138, 92, 0.5);
  border-radius: var(--radius-md);
  background: rgba(255, 138, 92, 0.06);
  color: var(--color-primary-deep);
  font-size: 15px;
  font-weight: 600;
  font-family: inherit;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  transition: background 0.15s, border-color 0.15s;
}
.role-custom-toggle:hover {
  background: rgba(255, 138, 92, 0.12);
}
/* 选中态：模板卡 / 自定义卡高亮 */
.role-card.selected {
  border-color: var(--color-primary);
  background: rgba(255, 138, 92, 0.1);
  box-shadow: inset 0 0 0 1px rgba(255, 138, 92, 0.55);
}
.role-card.selected .role-card-name {
  color: var(--color-primary-deep);
}
.role-custom-toggle.selected {
  border-style: solid;
  border-color: var(--color-primary);
  background: rgba(255, 138, 92, 0.12);
}
.role-custom-marker {
  font-size: 13px;
  font-weight: 500;
  color: var(--color-primary-deep);
  max-width: 55%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 页面右下角「开始」：内容不足时贴底，内容多了滚动时也吸附在底部 */
.role-start-bar {
  position: sticky;
  bottom: 0;
  margin-top: auto;
  padding: 14px 0 8px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
  background: linear-gradient(180deg, rgba(255, 248, 243, 0) 0%, var(--color-bg) 32%);
}
.role-start-btn {
  min-width: 104px;
  padding: 12px 24px;
  font-size: 15px;
}
/* 选角色页底部「已有账号直接登录」小字链接（游客可见，点开登录墙） */
.role-login-link {
  border: none;
  background: none;
  padding: 6px 2px 2px;
  font-size: 13px;
  color: var(--color-text-muted);
  cursor: pointer;
  align-self: center;
}
.role-login-link:active {
  color: var(--color-primary-deep);
}
/* 「开始」失败时的小字错误提示（建会话失败留在本页重试） */
.role-start-error {
  margin: 0;
  font-size: 13px;
}
/* ========== 自定义角色 · 全屏弹窗 ========== */
.role-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}
.role-modal {
  width: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}
.role-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 16px 10px;
  flex-shrink: 0;
}
.role-modal-title {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--color-text);
}
.role-modal-close {
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: var(--color-text-muted);
  font-size: 22px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.role-modal-close:hover {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}
.role-modal-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 4px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.role-modal-advanced {
  min-height: 220px;
  flex: 1;
}
.role-modal-footer {
  flex-shrink: 0;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--color-border);
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.role-modal-actions {
  display: flex;
  gap: 10px;
  margin-left: auto;
}
.role-modal-required-hint {
  font-size: 12px;
  color: #b3261e;
}
.role-modal-hint {
  margin: 0;
  font-size: 12px;
  color: var(--color-text-muted);
}
.role-modal-advanced-btn {
  align-self: flex-start;
}
.required-mark {
  font-size: 11px;
  font-weight: 500;
  color: var(--color-primary-deep);
  border: 1px solid rgba(255, 138, 92, 0.4);
  background: rgba(255, 138, 92, 0.08);
  border-radius: 6px;
  padding: 1px 6px;
  margin-left: 6px;
}
/* ========== 登录墙 LoginGate（B2b 游客登录门禁） ========== */
.login-gate {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow-y: auto;
  padding: 16px 20px 28px;
  background: var(--color-bg);
}
.login-gate-header {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.login-gate-inner {
  margin: auto;
  width: 100%;
  max-width: 360px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-gate-logo {
  width: 64px;
  height: 64px;
  border: none;
  padding: 0;
  border-radius: 20px;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
  color: var(--color-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  box-shadow: 0 6px 18px rgba(255, 138, 92, 0.35);
  font-family: inherit;
}
.login-gate-logo span {
  font-size: 32px;
  font-weight: 700;
  line-height: 1;
}
.login-gate-title {
  margin: 0 0 8px;
  font-size: 22px;
  font-weight: 800;
  color: var(--color-text);
  text-align: center;
}
.login-gate-sub {
