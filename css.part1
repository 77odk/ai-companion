/* ========== 全局：AI 伴侣 · 暖色调 ========== */
:root {
  --color-primary: #ff8a5c;
  --color-primary-soft: #ffd3b6;
  --color-primary-deep: #e96f3e;
  --color-bg: #fff8f3;
  --color-card: #ffffff;
  --color-text: #3d2c29;
  --color-text-muted: #9a7d74;
  --color-border: #f0dcd0;
  /* 主色底上的文字/图标色：主色够深为白，主色过浅自动切 deep（TASK_THEME 对比度保护） */
  --color-on-primary: #ffffff;
  --radius: 16px;
  --radius-sm: 12px;
  --radius-md: 16px;
  --shadow: 0 2px 14px rgba(61, 44, 41, 0.08);
  --max-width: 480px;
}
* {
  box-sizing: border-box;
}
html,
body,
#root {
  height: 100%;
  margin: 0;
}
body {
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', 'Segoe UI', Roboto, sans-serif;
  background: var(--color-bg);
  color: var(--color-text);
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
}
button {
  font-family: inherit;
  cursor: pointer;
}
/* ========== 应用外壳 ========== */
.app {
  display: flex;
  flex-direction: column;
  height: 100dvh;
  max-width: var(--max-width);
  margin: 0 auto;
  background: var(--color-bg);
}
.app-header {
  position: relative;
  padding: 18px 16px 12px;
  text-align: center;
  flex-shrink: 0;
}
.app-title {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
  color: var(--color-primary-deep);
  letter-spacing: 1px;
}
.app-subtitle {
  margin: 4px 0 0;
  font-size: 12px;
  color: var(--color-text-muted);
}
/* 顶栏右上角：进入 TA 的空间（极简线条小房子） */
.space-entry {
  position: absolute;
  right: 12px;
  top: 12px;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-text-muted);
  transition: color 0.15s, border-color 0.15s, background 0.15s;
}
.space-entry:hover {
  color: var(--color-primary-deep);
  border-color: rgba(255, 138, 92, 0.4);
  background: rgba(255, 138, 92, 0.06);
}
.space-entry svg {
  width: 20px;
  height: 20px;
}
/* 聊天页头部 TA 资料入口（2026-08-25：小星球图标，七七拍板替换头像） */
.chat-header-planet {
  position: absolute;
  right: 58px;
  top: 12px;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-text-muted);
  overflow: hidden;
  padding: 0;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
}
.chat-header-planet:hover {
  color: var(--color-primary-deep);
  border-color: rgba(255, 138, 92, 0.4);
  background: rgba(255, 138, 92, 0.06);
}
.chat-header-planet svg {
  width: 22px;
  height: 22px;
}
.chat-header-avatar {
  position: absolute;
  right: 58px;
  top: 12px;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-text-muted);
  overflow: hidden;
  padding: 0;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
}
.chat-header-avatar:hover {
  color: var(--color-primary-deep);
  border-color: rgba(255, 138, 92, 0.4);
  background: rgba(255, 138, 92, 0.06);
}
.chat-header-avatar-letter {
  color: var(--color-primary-deep);
  font-size: 17px;
  font-weight: 700;
  line-height: 1;
}
.chat-header-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.chat-header-avatar .avatar-default {
  width: 60%;
  height: 60%;
}
.app-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
/* ========== 底部导航 ========== */
.app-nav {
  display: flex;
  flex-shrink: 0;
  border-top: 1px solid var(--color-border);
  background: var(--color-card);
  padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
  gap: 8px;
}
.nav-btn {
  flex: 1;
  padding: 10px 0;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--color-text-muted);
  font-size: 14px;
  font-weight: 500;
  transition: background 0.15s, color 0.15s;
}
.nav-btn.active {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 600;
}
/* ========== 聊天页 ========== */
.chat-page {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}
.message-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 8px 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  scroll-behavior: auto;
}
/* 空状态欢迎页 */
.welcome {
  margin: auto;
  text-align: center;
  padding: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.welcome h2 {
  margin: 0;
  font-size: 20px;
  color: var(--color-text);
}
.welcome p {
  margin: 0;
  color: var(--color-text-muted);
  font-size: 14px;
}
.welcome-hint {
  margin-top: 4px !important;
}
/* 聊天页空状态引导卡（没配 key 时） */
.welcome-guide {
  margin-top: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}
.welcome-actions {
  display: flex;
  gap: 10px;
  justify-content: center;
}
/* 欢迎页「先看教程」小链接 */
.welcome-guide-link {
  margin-top: 14px;
  background: none;
  border: none;
  padding: 6px 12px;
  font-size: 13px;
  color: var(--color-text-muted);
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.welcome-guide-link:hover {
  color: var(--color-primary);
}
/* 服务商配置页「不会配？看指南」链接 */
.provider-guide-link {
  display: block;
  width: 100%;
  margin-bottom: 12px;
  background: none;
  border: none;
  padding: 6px 0;
  font-size: 13px;
  text-align: center;
  color: var(--color-primary);
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
}
/* 聊天页错误提示 + 429 切换豆包 */
.chat-error-wrap {
  padding: 0 12px 8px;
}
.rate-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 6px;
  font-size: 13px;
}
.rate-fallback-text {
  color: var(--color-text-muted);
}
.rate-fallback-btn {
  background: none;
  border: none;
  padding: 2px 6px;
  font-size: 13px;
  color: var(--color-primary);
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.rate-fallback-btn:hover {
  opacity: 0.8;
}
/* 指南里的直达链接（手机点击跳官方页面） */
.guide-link {
  color: var(--color-primary);
  text-decoration: underline;
  text-underline-offset: 3px;
  word-break: break-all;
}
.guide-link:hover {
  opacity: 0.8;
}
/* 消息气泡 */
.message-row {
  display: flex;
  align-items: flex-end;
  gap: 8px;
}
/* 每条气泡自带时间（2026-08-26 七七拍板，AM/PM 微信式） */
.msg-bubble-time {
  display: block;
  font-size: 10px;
  color: var(--color-text-3, #b0b0b6);
  margin-top: 3px;
  padding-left: 2px;
  line-height: 1;
}
.row-user .msg-bubble-time {
  text-align: right;
  padding-left: 0;
  padding-right: 2px;
}
.row-user {
  justify-content: flex-end;
}
.row-assistant {
  justify-content: flex-start;
}
.msg-avatar {
  flex: none;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  overflow: hidden;
}
.msg-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.msg-avatar .avatar-default {
  width: 60%;
  height: 60%;
}
/* 消息区 TA 头像可点开资料卡（TASK-UI3）：按钮包住原头像，尺寸/圆角不变 */
.msg-avatar-btn {
  flex: none;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
  cursor: pointer;
}
.user-avatar {
  background: rgba(255, 138, 92, 0.12);
  border-color: transparent;
}
.bubble {
  max-width: 82%;
  padding: 10px 14px;
  border-radius: var(--radius);
  font-size: 15px;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}
.bubble-user {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-bottom-right-radius: 6px;
}
.bubble-assistant {
  background: var(--color-card);
  color: var(--color-text);
  border: 1px solid var(--color-border);
  border-bottom-left-radius: 6px;
  box-shadow: var(--shadow);
}
/* 消息正文区（气泡 + 下方小字提示） */
.message-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-width: 82%;
}
.message-body .bubble {
  max-width: 100%;
}
.row-user .message-body {
  align-items: flex-end;
}
/* TA 记住时，气泡下方的小字 */
.memory-remembered {
  padding-left: 4px;
  font-size: 11px;
  color: var(--color-primary-deep);
  opacity: 0.8;
}
/* 用户指令触发记忆写入时，用户气泡下方的小字反馈（与「已记住」同款浅色小字，右对齐贴气泡） */
.memory-saved {
  padding-right: 4px;
  font-size: 11px;
  color: var(--color-primary-deep);
  opacity: 0.8;
}
/* 正在输入动画 */
.typing {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 2px 4px;
}
.typing .typing-text {
  font-size: 0.85em;
  color: var(--color-text-secondary, #999);
  margin-right: 2px;
}
.typing i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--color-primary-soft);
  animation: typing-blink 1.2s infinite ease-in-out;
}
.typing i:nth-child(2) {
  animation-delay: 0.15s;
}
.typing i:nth-child(3) {
  animation-delay: 0.3s;
}
@keyframes typing-blink {
  0%,
  60%,
  100% {
    opacity: 0.4;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-3px);
  }
}
/* 错误提示条 */
.chat-error {
  margin: 0 14px 10px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: #fdecea;
  color: #b3261e;
  font-size: 13px;
  line-height: 1.5;
}
/* 输入区 */
.composer {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  gap: 8px;
  padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--color-border);
  background: var(--color-card);
}
.composer-input {
  flex: 1;
  resize: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  font-size: 15px;
  line-height: 1.5;
  font-family: inherit;
  color: var(--color-text);
  background: var(--color-bg);
  outline: none;
  max-height: 120px;
}
.composer-input:focus {
  border-color: var(--color-primary);
}
/* 按钮 */
.btn {
  border: none;
  border-radius: var(--radius-sm);
  padding: 10px 18px;
  font-size: 14px;
  font-weight: 600;
  transition: background 0.15s, opacity 0.15s;
}
.btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
}
.btn-primary:hover:not(:disabled) {
  background: var(--color-primary-deep);
}
.btn-ghost {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}
.btn-ghost:hover:not(:disabled) {
  background: #ffc7a6;
}
.btn-send {
  background: var(--color-primary);
  color: var(--color-on-primary);
  padding: 10px 16px;
}
.btn-stop {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  padding: 10px 16px;
}
/* ========== 通用页面（设置/记忆） ========== */
.page {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 16px 16px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.page-desc {
  margin: 0;
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text-muted);
}
.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.field label {
  font-size: 13px;
  font-weight: 600;
  color: var(--color-text);
}
/* 性别三选一分段（男/女/未知）：设定弹窗与 TA 资料卡共用 */
.gender-options {
  display: flex;
  gap: 8px;
}
.gender-option {
  flex: 1;
  padding: 10px 0;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-family: inherit;
  color: var(--color-text);
  background: var(--color-card);
  cursor: pointer;
  transition: all 0.15s ease;
}
.gender-option.active {
  border-color: var(--color-primary);
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
  font-weight: 600;
}
/* 表单里「选填」的小标签（设定弹窗） */
.optional-mark {
  font-size: 11px;
  font-weight: 400;
  color: var(--color-text-muted);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  padding: 1px 7px;
  margin-left: 6px;
  vertical-align: 1px;
}
.input {
  padding: 10px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 15px;
  font-family: inherit;
  color: var(--color-text);
  background: var(--color-card);
  outline: none;
  width: 100%;
}
.input:focus {
  border-color: var(--color-primary);
}
select.input {
  appearance: auto;
}
textarea.persona-input {
  resize: vertical;
  min-height: 100px;
  line-height: 1.6;
}
.hint {
  margin: 0;
  font-size: 12px;
  color: var(--color-text-muted);
}
/* key 格式不对时输入框下方的红色小字（帮用户发现选错服务商） */
.key-format-hint {
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
  color: #b3261e;
}
/* 账号输入框下边的即时格式提示（B2a 三标识：手机号/邮箱/用户名） */
.account-format-hint {
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
  color: #b3261e;
}
.settings-actions {
  display: flex;
  gap: 10px;
}
.settings-card {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  margin-bottom: 14px;
}
.settings-card-title {
  margin: 0 0 12px;
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text);
}
.advanced-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  margin: 4px 0 8px;
  padding: 6px 0;
  border: none;
  background: none;
  color: var(--color-primary);
  font-size: 13px;
  cursor: pointer;
  text-align: left;
}
.advanced-chevron {
  width: 14px;
  height: 14px;
  color: var(--color-primary);
  transition: transform 0.2s ease;
}
.advanced-chevron.collapsed {
  transform: rotate(180deg);
}
/* 头像选择器 */
.avatar-pick-area {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.avatar-preview {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--color-border);
  background: var(--color-card);
}
.avatar-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.avatar-preview .avatar-default {
  width: 55%;
  height: 55%;
  color: var(--color-text-muted);
}
.avatar-pick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.avatar-upload-btn {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.avatar-upload-icon {
  width: 16px;
  height: 16px;
}
.settings-actions .btn {
  flex: 1;
}
/* S1-2 「TA 的资料」角色卡：首字圆形头像 + 角色名（跟当前会话角色走，不再是全局资料） */
.ai-role-card {
  display: flex;
  align-items: center;
  gap: 14px;
}
.ai-role-avatar {
  flex: none;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 22px;
  font-weight: 700;
  overflow: hidden;
}
.ai-role-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.ai-role-name {
  font-size: 17px;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-role-sub {
  font-size: 12px;
  color: var(--color-text-muted);
}
/* 改名：输入框 + 按钮一行 */
.ai-save-row {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}
.ai-save-row .input {
  flex: 1;
}
/* 保存按钮靠右（TA 资料卡的性格/背景/开场白字段） */
.ai-save-row-end {
  justify-content: flex-end;
}
.ai-save-btn {
  flex: none;
  width: 72px;
  padding: 10px 0;
}
/* 账号与同步 */
.account-email {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text);
  word-break: break-all;
}
.account-toggle {
  margin-top: 14px;
  padding: 0;
  border: none;
  background: none;
  font-size: 13px;
  color: var(--color-primary);
  cursor: pointer;
}
.account-toggle:hover {
  color: var(--color-primary-deep);
}
/* 登录/注册 tab（2026-08-26 七七拍板：清晰分开，别把登录页误认成注册页） */
.account-tabs {
  display: flex;
  margin-bottom: 18px;
  background: var(--color-bg-2, #f4f4f6);
  border-radius: 10px;
  padding: 3px;
}
.account-tab {
  flex: 1;
  text-align: center;
  padding: 9px 0;
  border: none;
  background: none;
  font-size: 14px;
  color: var(--color-text-3, #888);
  border-radius: 8px;
  cursor: pointer;
}
.account-tab.on {
  background: #fff;
  color: var(--color-text, #222);
  font-weight: 600;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
}
.test-result {
  margin: 0;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  line-height: 1.5;
  background: var(--color-bg);
  color: var(--color-text);
}
.test-result.success {
  background: #e9f7ec;
  color: #1e7d3a;
}
.test-result.error {
  background: #fdecea;
  color: #b3261e;
}
/* B2e：找回密码 / 账号绑定 */
.account-mode-label {
  margin: 0 0 6px;
  font-size: 12px;
  color: var(--color-text-2, #888);
}
.forgot-code-row {
  display: flex;
  gap: 8px;
  align-items: center;
}
.forgot-code-row .input {
  flex: 1;
  min-width: 0;
}
.forgot-code-row .btn {
  white-space: nowrap;
  flex-shrink: 0;
}
.verify-row {
  display: flex;
  gap: 8px;
  align-items: center;
}
.verify-row .input {
  flex: 1;
  min-width: 0;
}
.verify-row .btn {
  white-space: nowrap;
  flex-shrink: 0;
}
.identities-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.identity-chip {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--color-bg, #f5f5f5);
  font-size: 12px;
  color: var(--color-text, #333);
}
.bind-row {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 6px;
}
.bind-row .input {
  flex: 1;
  min-width: 0;
}
.bind-row .bind-select {
  flex: 0 0 88px;
}
.bind-row .btn {
  white-space: nowrap;
  flex-shrink: 0;
}
/* 记忆页 */
.memory-input-row {
  display: flex;
  gap: 8px;
}
.memory-input-row .input {
  flex: 1;
}
.memory-topic-input {
  flex: none !important;
  width: 96px;
  text-align: center;
}
.memory-add-btn {
  width: 100%;
}
/* 忆览页：顶部模块标题 + 全部角色卡片画廊 */
.memory-page-title {
  margin: 0;
  font-size: 20px;
  font-weight: 800;
  color: var(--color-text);
}
.memory-roles {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.memory-roles-title {
  margin: 0 4px 0;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-text-muted);
  letter-spacing: 0.04em;
}
.memory-roles-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
/* 角色卡片：首字圆形头像 + 角色名 + 摘要/相处天数小字（禁 emoji，主色软底） */
.memory-role-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 14px 8px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-card);
  font-family: inherit;
  cursor: pointer;
  text-align: center;
  min-width: 0;
  transition: border-color 0.15s, background 0.15s;
}
.memory-role-card:hover,
.memory-role-card:focus-visible {
  border-color: rgba(255, 138, 92, 0.45);
  background: rgba(255, 138, 92, 0.06);
}
.memory-role-avatar {
  flex: none;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 18px;
  font-weight: 700;
  overflow: hidden;
}
.memory-role-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}
.memory-role-name {
  max-width: 100%;
  font-size: 14px;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.memory-role-sub {
  max-width: 100%;
  font-size: 12px;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 空状态：有温度，不说"暂无记忆" */
.memory-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 48px 24px;
  text-align: center;
}
.memory-empty-mark {
  width: 40px;
  height: 40px;
  color: var(--color-primary-soft);
  margin-bottom: 8px;
}
.memory-empty-title {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text);
}
.memory-empty-sub {
  margin: 0;
  font-size: 13px;
  line-height: 1.7;
  color: var(--color-text-muted);
}
/* 记忆主题卡 */
.memory-topics {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.memory-topic-card {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.memory-topic-head {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border: none;
  background: transparent;
  cursor: pointer;
  text-align: left;
}
.memory-topic-name {
  padding: 3px 12px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.5;
}
.memory-topic-chevron {
  margin-left: auto;
  width: 16px;
  height: 16px;
  color: var(--color-text-muted);
  transition: transform 0.2s ease;
}
.memory-topic-chevron.collapsed {
  transform: rotate(-90deg);
}
.topic-soft-0 {
  color: #b26a4e;
  background: rgba(255, 138, 92, 0.16);
}
.topic-soft-1 {
  color: #6b7f3f;
  background: rgba(132, 169, 74, 0.16);
}
.topic-soft-2 {
  color: #4d7b9e;
  background: rgba(90, 148, 196, 0.16);
}
.topic-soft-3 {
  color: #8a5aa8;
  background: rgba(164, 106, 192, 0.16);
}
.topic-soft-4 {
  color: #b07f3a;
  background: rgba(224, 168, 84, 0.2);
}
.topic-soft-5 {
  color: #a24e5e;
  background: rgba(214, 106, 130, 0.14);
}
.memory-topic-items {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px dashed var(--color-border);
}
.memory-item {
  position: relative;
  padding: 12px 136px 12px 16px;
  border-bottom: 1px solid var(--color-border);
}
.memory-item:last-child {
  border-bottom: none;
}
.memory-item-text {
  margin: 0 0 8px;
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text);
  word-break: break-word;
}
.memory-item-foot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 10px;
  font-size: 12px;
  color: var(--color-text-muted);
}
.memory-item-date {
  white-space: nowrap;
  color: var(--color-primary-deep);
  opacity: 0.85;
}
.memory-item-source {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
/* 很久没提起：低调小字标签，别喧宾夺主 */
.memory-item-stale {
  flex: none;
  font-size: 11px;
  line-height: 1.6;
  color: var(--color-text-muted);
  opacity: 0.65;
  background: var(--color-bg);
  padding: 1px 8px;
  border-radius: 999px;
}
/* 双源信任来源小标记：用户明说的「你说的」（暖橘）/ TA 推断的「TA 记得的」（暖灰），都低调 */
.memory-source-tag {
  flex: none;
  font-size: 11px;
  line-height: 1.6;
  padding: 1px 8px;
  border-radius: 999px;
}
.memory-source-tag.memory-source-user {
  color: var(--color-primary-deep);
  background: rgba(255, 138, 92, 0.14);
}
.memory-source-tag.memory-source-ta {
  color: var(--color-text-muted);
  background: var(--color-bg);
  opacity: 0.85;
}
.memory-delete {
  flex-shrink: 0;
  position: absolute;
  top: 8px;
  right: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  padding: 6px;
  border-radius: 8px;
  opacity: 0.4;
}
.memory-delete svg {
  width: 15px;
  height: 15px;
}
.memory-delete:hover,
.memory-delete:focus-visible {
  opacity: 1;
  color: #b3261e;
  background: #fdecea;
}
/* 记忆条右上操作区：置顶「重要」按钮 + 删除按钮排在一起 */
.memory-item-actions {
  position: absolute;
  top: 8px;
  right: 10px;
  display: flex;
  align-items: center;
  gap: 2px;
}
.memory-item-actions .memory-delete {
  position: static;
}
/* 「重要」置顶按钮：线条星星，暖灰 → 点亮后暖橘 */
.memory-pin {
  display: flex;
  align-items: center;
  gap: 4px;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  padding: 6px;
  border-radius: 8px;
  opacity: 0.4;
  cursor: pointer;
  font-size: 11px;
  line-height: 1;
}
.memory-pin svg {
  width: 15px;
  height: 15px;
}
.memory-pin:hover,
.memory-pin:focus-visible {
  opacity: 1;
  color: var(--color-primary);
  background: rgba(255, 138, 92, 0.12);
}
.memory-pin.pinned {
  opacity: 1;
  color: var(--color-primary);
  font-weight: 600;
}
.memory-pin-label {
  font-size: 11px;
  white-space: nowrap;
}
/* 编辑按钮：与删除按钮同一档位的细描边铅笔，hover 才明显 */
.memory-edit {
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  padding: 6px;
  border-radius: 8px;
  opacity: 0.4;
}
.memory-edit svg {
  width: 15px;
  height: 15px;
}
.memory-edit:hover,
.memory-edit:focus-visible {
  opacity: 1;
  color: var(--color-primary-deep);
  background: rgba(255, 138, 92, 0.12);
}
/* 内联编辑：输入框 + 保存/取消 */
.memory-item-edit {
  margin-bottom: 8px;
}
.memory-item-edit .input {
  width: 100%;
  box-sizing: border-box;
}
.memory-item-edit-actions {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}
.memory-item-edit-actions .btn {
  padding: 4px 12px;
  font-size: 13px;
}
/* 无会话时的引导条：记忆页顶部低调提示 */
.memory-session-guide {
  margin: 0 0 14px;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  background: var(--color-bg);
  border: 1px dashed var(--color-border);
  color: var(--color-text-muted);
  font-size: 13px;
  line-height: 1.7;
}
.memory-session-guide p {
  margin: 0;
}
/* 会话模式上传/删除失败提示：醒目但不打断 */
.memory-error {
  margin: 0 0 14px;
  padding: 8px 12px;
  border-radius: var(--radius-md);
  background: #fdecea;
  color: #b3261e;
  font-size: 13px;
  line-height: 1.6;
}
/* 记忆页 v2 · 「TA 眼中的你」汇总卡（暖橘渐变大卡，页面的灵魂） */
.memory-summary-card {
  background: linear-gradient(135deg, #fff1e0 0%, #fff8f3 55%, #ffe7d0 100%);
  border: 1px solid #f3dcc7;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  padding: 18px 18px 16px;
}
.memory-summary-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.memory-summary-title {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
  color: var(--color-primary-deep);
}
.memory-summary-hint {
  margin: 0;
  font-size: 12px;
  color: var(--color-primary);
}
.memory-summary-stats {
  margin: 0;
  font-size: 14px;
  line-height: 1.7;
  color: var(--color-text);
}
.memory-summary-stats strong {
  color: var(--color-primary-deep);
  font-weight: 700;
}
.memory-summary-top {
  margin: 8px 0 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--color-primary-deep);
}
.memory-summary-llm {
  margin: 12px 0 0;
  padding: 10px 12px;
  border-left: 3px solid var(--color-primary);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  background: rgba(255, 255, 255, 0.65);
  font-size: 15px;
  line-height: 1.8;
  color: var(--color-text);
}
/* 主题卡：N 条小标 */
.memory-topic-count {
  flex: none;
  font-size: 11px;
  font-weight: 600;
  color: var(--color-text-muted);
  background: var(--color-bg);
  padding: 2px 8px;
  border-radius: 999px;
}
/* 主题卡：最新一条置顶加粗（最戳心的那句） */
.memory-item-featured {
  border-bottom: none;
  padding-top: 14px;
  padding-bottom: 14px;
}
.memory-item-featured .memory-item-text {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text);
}
/* ========== 纪念日：记忆页小卡片 + 管理页 ========== */
/* 主题色：柔和色块（跟记忆页 topic-soft 同色系），用 CSS 变量让各处统一取色 */
.ann-color-0 { --ann-color: #b26a4e; } /* 暖橘 */
.ann-color-1 { --ann-color: #b07f3a; } /* 暖黄 */
.ann-color-2 { --ann-color: #a24e5e; } /* 暖粉 */
.ann-color-3 { --ann-color: #4d7b9e; } /* 暖蓝 */
.ann-color-4 { --ann-color: #6b7f3f; } /* 暖绿 */
/* ---- 记忆页小展示卡：一行高度，像笺的大小，不挡记忆 ---- */
.anniversary-strip {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  margin-bottom: 12px;
  cursor: pointer;
  text-align: left;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.anniversary-strip:hover,
.anniversary-strip:focus-visible {
  border-color: rgba(255, 138, 92, 0.45);
  box-shadow: 0 2px 16px rgba(61, 44, 41, 0.12);
}
.anniversary-strip-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(255, 138, 92, 0.12);
  color: var(--color-primary);
}
.anniversary-strip-icon svg {
  width: 18px;
  height: 18px;
}
.anniversary-strip-title {
  flex: none;
  font-size: 14px;
  font-weight: 700;
  color: var(--color-text);
}
.anniversary-strip-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1px;
}
.anniversary-strip-count {
  font-size: 16px;
  font-weight: 700;
  color: var(--ann-color, var(--color-primary-deep));
  white-space: nowrap;
}
.anniversary-strip-label {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  color: var(--color-text-muted);
}
.anniversary-strip-empty {
  font-size: 14px;
  color: var(--color-text-muted);
}
.anniversary-strip-arrow {
  flex: none;
  font-size: 20px;
  line-height: 1;
  color: var(--color-text-muted);
}
/* ---- 纪念日管理页 ---- */
.anniversary-page {
  padding: 0;
}
.anniversary-page-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 16px 16px 28px;
}
.anniversary-section-head {
  margin-bottom: 8px;
}
.anniversary-section-title {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
  color: var(--color-text);
}
.anniversary-section-desc {
  margin: 2px 0 0;
  font-size: 12px;
  color: var(--color-text-muted);
}
/* 主展示切换区 */
.anniversary-main-list {
  list-style: none;
  margin: 0;
  padding: 4px 0;
  display: flex;
  flex-direction: column;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.anniversary-main-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
}
.anniversary-main-item + .anniversary-main-item {
  border-top: 1px dashed var(--color-border);
}
.anniversary-main-item.is-main {
  background: rgba(255, 138, 92, 0.06);
}
.anniversary-main-dot {
  flex: none;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--ann-color, var(--color-primary));
}
.anniversary-main-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text);
}
.anniversary-main-date {
  flex: none;
  font-size: 13px;
  color: var(--color-text-muted);
}
.anniversary-main-btn {
  flex: none;
  border: none;
  border-radius: 999px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 600;
  background: rgba(255, 138, 92, 0.14);
  color: var(--color-primary-deep);
}
.anniversary-main-btn:disabled {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  cursor: default;
}
.anniversary-main-btn:not(:disabled):hover,
.anniversary-main-btn:not(:disabled):focus-visible {
  background: rgba(255, 138, 92, 0.22);
}
/* 全部纪念日列表 */
.anniversary-page-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.anniversary-page-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}
.anniversary-page-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.anniversary-page-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.anniversary-page-dot {
  flex: none;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--ann-color, var(--color-primary));
}
.anniversary-page-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}
.anniversary-page-date {
  font-size: 13px;
  color: var(--color-text-muted);
}
.anniversary-mode-tag {
  font-size: 11px;
  font-weight: 600;
  color: var(--color-primary-deep);
  background: rgba(255, 138, 92, 0.12);
  border-radius: 999px;
  padding: 2px 8px;
}
.anniversary-mode-tag.is-countdown {
  color: #4d7b9e;
  background: rgba(90, 148, 196, 0.14);
}
.anniversary-kind-tag {
  font-size: 11px;
  font-weight: 600;
  color: var(--color-text-muted);
  background: rgba(120, 120, 130, 0.12);
  border-radius: 999px;
  padding: 2px 8px;
}
.anniversary-kind-tag.is-personal {
  color: #8a6d4d;
  background: rgba(180, 150, 100, 0.16);
}
/* 里程碑条目标：暖金「里程碑」（TASK-UI3 自动生成，与普通条目区分开） */
.anniversary-milestone-tag {
  font-size: 11px;
  font-weight: 700;
  color: #a8721f;
  background: rgba(230, 180, 80, 0.18);
  border-radius: 999px;
  padding: 2px 8px;
}
/* 大日子卡正在展示的那条：暖描边 + 浅底，一眼看出点的是哪条 */
.anniversary-page-item.is-displayed {
  border-color: var(--color-primary);
  background: rgba(255, 138, 92, 0.06);
}
.anniversary-page-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4px;
}
.anniversary-page-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  padding: 6px;
  border-radius: 8px;
  opacity: 0.5;
}
.anniversary-page-btn svg {
  width: 15px;
  height: 15px;
}
.anniversary-page-btn:hover,
.anniversary-page-btn:focus-visible {
  opacity: 1;
  color: var(--color-primary-deep);
  background: rgba(255, 138, 92, 0.12);
}
.anniversary-page-btn.danger:hover,
.anniversary-page-btn.danger:focus-visible {
  color: #b3261e;
  background: #fdecea;
}
.anniversary-confirm {
  display: flex;
  align-items: center;
  gap: 6px;
}
/* 空状态：用户把纪念日删光了 */
.anniversary-page-empty {
  padding: 28px 16px;
  text-align: center;
  font-size: 14px;
  color: var(--color-text-muted);
  background: var(--color-card);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-md);
}
/* 添加按钮 */
.anniversary-page-add {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-card);
  color: var(--color-primary-deep);
  padding: 12px 14px;
  font-size: 14px;
  font-weight: 600;
}
.anniversary-page-add svg {
  width: 15px;
  height: 15px;
}
.anniversary-page-add:hover,
.anniversary-page-add:focus-visible {
  background: rgba(255, 138, 92, 0.08);
  border-color: var(--color-primary-soft);
}
/* 添加 / 编辑表单 */
.anniversary-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 16px 14px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}
.anniversary-form-title {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text);
}
.anniversary-form-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--color-text-muted);
}
.anniversary-form-mode,
.anniversary-form-color {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.anniversary-mode-options {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.anniversary-mode-option {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: var(--color-text);
  padding: 8px 10px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
}
.anniversary-mode-option.active {
  border-color: rgba(255, 138, 92, 0.45);
  background: rgba(255, 138, 92, 0.06);
}
.anniversary-mode-option input {
  accent-color: var(--color-primary);
}
/* 纪念日表单提示（2026-08-26：个人日子在关于我里添加） */
.anniversary-form-note {
  font-size: 12px;
  color: var(--color-text-3, #999);
  padding: 4px 2px;
  line-height: 1.5;
}
.anniversary-color-options {
  display: flex;
  gap: 10px;
}
.anniversary-color-swatch {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid transparent;
  background: var(--ann-color, var(--color-primary));
  cursor: pointer;
  transition: transform 0.12s, border-color 0.12s;
}
.anniversary-color-swatch:hover,
.anniversary-color-swatch:focus-visible {
  transform: scale(1.1);
}
.anniversary-color-swatch.selected {
  border-color: var(--color-card);
  box-shadow: 0 0 0 2px var(--color-primary-deep);
}
.anniversary-form-actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
}
/* 小号按钮：行内编辑/新增表单里的保存、取消 */
.btn-sm {
  padding: 7px 14px;
  font-size: 13px;
}
/* ========== 主页（角色卡） ========== */
.home-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow-y: auto;
  text-align: center;
  padding: 24px 20px;
}
.home-inner {
  margin: auto;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.home-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-deep));
  color: var(--color-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
  box-shadow: 0 6px 20px rgba(255, 138, 92, 0.35);
}
.home-avatar svg {
  width: 52px;
  height: 52px;
}
.home-name {
  margin: 0 0 6px;
  font-size: 22px;
  font-weight: 700;
  color: var(--color-text);
}
.home-greeting {
  margin: 0 0 24px;
  font-size: 15px;
  color: var(--color-text-muted);
}
.home-start {
  min-width: 180px;
  padding: 12px 0;
  font-size: 16px;
}
.home-persona-note {
  margin: 14px 0 0;
  font-size: 13px;
  color: var(--color-primary-deep);
}
.home-links {
  margin-top: 20px;
}
.link-btn {
  border: none;
  background: none;
  color: var(--color-text-muted);
  font-size: 14px;
  padding: 6px 14px;
  cursor: pointer;
}
.home-tip {
  position: absolute;
  bottom: 84px;
  margin: 0;
  font-size: 12px;
  color: var(--color-text-muted);
  opacity: 0.75;
}
/* 主页：干活中心入口卡片 */
.home-work-card {
  margin-top: 24px;
  width: 100%;
  max-width: 320px;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 16px;
  box-shadow: var(--shadow);
}
.home-work-title {
  margin: 0 0 6px;
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text);
}
.home-work-desc {
  margin: 0 0 12px;
  font-size: 13px;
  line-height: 1.6;
  color: var(--color-text-muted);
}
.home-work-btn {
  width: 100%;
}
/* ========== AI 工作台 ========== */
.work-title {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--color-text);
}
.work-memory {
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}
.showcase-card {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.showcase-head {
  display: flex;
  align-items: center;
  gap: 10px;
}
.showcase-icon {
  width: 22px;
  height: 22px;
  color: var(--color-primary-deep);
  flex: none;
}
.showcase-icon svg {
  width: 22px;
  height: 22px;
}
.showcase-badge {
  margin-left: auto;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  color: var(--color-primary, #ff8a5c);
  background: rgba(255, 138, 92, 0.12);
  white-space: nowrap;
}
/* 工作台 v2 · 点菜台（展示模式：主卖点 + 对话式入口 + 已会能力小块 + 底部钩子） */
.work-hero {
  margin: 4px 0 0;
  font-size: 22px;
  font-weight: 800;
  line-height: 1.5;
  text-align: center;
  color: var(--color-text);
}
/* 「我的」页里的工作台子页：避免 .page 双层内边距，工作台自身内容不再套一层 */
.work-subpage {
  gap: 8px;
}
.work-subpage .work-page {
  padding: 0 0 8px;
  overflow: visible;
}
.work-ask-card {
  background: linear-gradient(135deg, #fff1e0 0%, #ffffff 55%, #ffe7d0 100%);
  border: 1px solid #f3dcc7;
  box-shadow: var(--shadow);
}
.work-ask-desc {
  margin: 0 0 12px;
  font-size: 14px;
  line-height: 1.7;
  color: var(--color-text);
}
.work-ask-row {
  display: flex;
  gap: 8px;
}
.work-ask-row .input {
  flex: 1;
}
.work-ask-btn {
  flex: none;
  white-space: nowrap;
}
.work-ask-hint {
  margin: 8px 0 0;
  font-size: 12px;
  color: var(--color-primary-deep);
}
.work-known-title {
  margin: 0 0 6px;
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text);
}
.work-known-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px 12px;
}
.work-known-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 2px;
  font-size: 13px;
  color: var(--color-text);
  min-width: 0;
}
.work-known-icon {
  width: 16px;
  height: 16px;
  color: var(--color-primary-deep);
  flex: none;
}
.work-known-icon svg {
  width: 16px;
  height: 16px;
}
.work-known-name {
  flex: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.work-known-item .showcase-badge {
  margin-left: auto;
}
.work-foot-hook {
  margin: 2px 0 0;
  font-size: 13px;
  line-height: 1.7;
  color: var(--color-text-muted);
  text-align: center;
}
.work-lock-desc {
  margin-bottom: 12px;
}
.work-file-pick {
  margin-top: 4px;
}
.work-file-btn {
  width: 100%;
  padding: 12px;
  background: var(--color-bg);
  border: 1px dashed var(--color-border);
}
.work-files {
  margin: 8px 0 0;
  word-break: break-all;
}
.work-checks {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}
.work-check {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--color-text);
}
.work-check input {
  accent-color: var(--color-primary);
}
.work-regex {
  margin-top: 8px;
}
.work-row {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}
.work-row .field {
  flex: 1;
}
.work-actions {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}
.work-actions .btn {
  flex: 1;
}
.work-result-area {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.work-progress {
  color: var(--color-primary-deep);
}
.work-done {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: stretch;
}
